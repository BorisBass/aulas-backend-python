    "# Exercício 8: Soma Segura de Números\n",
    "num1_str = input(\"Digite o primeiro número: \")\n",
    "num2_str = input(\"Digite o segundo número: \")\n",
    "\n",
    "try:\n",
    "    num1 = float(num1_str)\n",
    "    num2 = float(num2_str)\n",
    "    soma = num1 + num2\n",
    "    print(f\"A soma é: {soma}\")\n",
    "except ValueError:\n",
    "    print(\"Erro: Por favor, digite apenas números válidos.\")"
