    "# Exercício 1: Identificação de Tipos de Dados\n",
    "# Variável 1\n",
    "idade = 30\n",
    "# Tipo: int\n",
    "print(type(idade))\n",
    "\n",
    "# Variável 2\n",
    "preco = 19.99\n",
    "# Tipo: float\n",
    "print(type(preco))\n",
    "\n",
    "# Variável 3\n",
    "nome = \"Maria\"\n",
    "# Tipo: str\n",
    "print(type(nome))\n",
    "\n",
    "# Variável 4\n",
    "is_estudante = True\n",
    "# Tipo: bool\n",
    "print(type(is_estudante))\n",
    "\n",
    "# Variável 5\n",
    "numero_grande = 1000000\n",
    "# Tipo: int\n",
    "print(type(numero_grande))\n",
    "\n",
    "# Variável 6\n",
    "temperatura = -5.5\n",
    "# Tipo: float\n",
    "print(type(temperatura))\n",
    "\n",
    "# Variável 7\n",
    "mensagem = \"Olá, mundo!\"\n",
    "# Tipo: str\n",
    "print(type(mensagem))\n",
    "\n",
    "# Variável 8\n",
    "tem_desconto = False\n",
    "# Tipo: bool\n",
    "print(type(tem_desconto))"
   ]
